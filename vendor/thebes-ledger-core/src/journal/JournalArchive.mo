/// JournalArchive.mo: read-only archive canister for journal blocks.
///
/// Same mechanism as the canonical ledger's `Archive.mo`: spawned by the
/// journal, accepts raw block bytes only from its parent, serves them by
/// absolute index. Journal blocks are self-describing (Canonical.mo: the hash
/// is embedded and recomputed on decode), so an archived block is verified the
/// same way as a live one; bytes hash to the block hash, the block hash is a
/// leaf of the parent's Merkle Mountain Range, whose root is in the parent's
/// certified data. The parent keeps every MMR leaf, so proofs for archived
/// blocks are still generated by the parent.
///
/// What archiving does and does not do on the substrate: the parent's Region-backed
/// log cannot shrink (Region memory is never freed), so archiving copies blocks
/// to an independently readable canister and stops serving them from the
/// parent; it does not reduce the parent's stable memory. The upstream token
/// ledger's archive has the same property.

import Principal "mo:core/Principal";
import Nat "mo:core/Nat";
import Blob "mo:core/Blob";
import Array "mo:core/Array";
import Runtime "mo:core/Runtime";

import SLog "../ledger/StableLog";
import T "JournalTypes";
import C "Canonical";

shared (initMsg) persistent actor class JournalArchive(parentPrincipal : Principal) {

  ignore initMsg;
  let parent : Principal = parentPrincipal;
  let log : SLog.State = SLog.newState();
  var firstIndex : Nat = 0;
  var initialised : Bool = false;

  /// Set the absolute index of the first block this archive holds. Parent only, once.
  public shared ({ caller }) func init(startIndex : Nat) : async () {
    if (not Principal.equal(caller, parent)) Runtime.trap("JournalArchive: not the parent");
    if (initialised) Runtime.trap("JournalArchive: already initialised");
    firstIndex := startIndex;
    initialised := true;
  };

  /// Append raw blocks in order. Parent only. Each block must decode and carry
  /// the index the archive expects next; an archive never holds a gap or a
  /// block whose bytes fail their own hash.
  public shared ({ caller }) func appendBlocks(blocks : [Blob]) : async Nat {
    if (not Principal.equal(caller, parent)) Runtime.trap("JournalArchive: not the parent");
    if (not initialised) Runtime.trap("JournalArchive: not initialised");
    var n = 0;
    for (b in blocks.vals()) {
      let expected = firstIndex + SLog.size(log);
      switch (C.decodeBlock(b)) {
        case (?blk) { if (blk.index != expected) Runtime.trap("JournalArchive: block index " # Nat.toText(blk.index) # " expected " # Nat.toText(expected)) };
        case null Runtime.trap("JournalArchive: block bytes do not decode");
      };
      ignore SLog.append(log, b);
      n += 1;
    };
    n
  };

  public query func raw_block(index : Nat) : async ?Blob {
    if (index < firstIndex) return null;
    SLog.get(log, index - firstIndex)
  };

  public query func block(index : Nat) : async ?T.Block {
    if (index < firstIndex) return null;
    switch (SLog.get(log, index - firstIndex)) { case (?b) C.decodeBlock(b); case null null }
  };

  /// Raw blocks by absolute index range.
  public query func get_blocks(start : Nat, length : Nat) : async { blocks : [Blob]; first_index : Nat; length : Nat } {
    let total = SLog.size(log);
    if (total == 0 or start < firstIndex) return { blocks = []; first_index = firstIndex; length = 0 };
    let localStart = start - firstIndex;
    if (localStart >= total) return { blocks = []; first_index = firstIndex; length = 0 };
    let localEnd = Nat.min(localStart + length, total);
    let out = Array.tabulate<Blob>(localEnd - localStart, func(i) { switch (SLog.get(log, localStart + i)) { case (?b) b; case null "" : Blob } });
    { blocks = out; first_index = start; length = out.size() }
  };

  public query func info() : async { first_index : Nat; block_count : Nat; parent : Principal } {
    { first_index = firstIndex; block_count = SLog.size(log); parent }
  };
};
